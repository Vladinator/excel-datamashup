{
  "name": "excel-datamashup",
  "version": "1.0.13",
  "description": "Read and edit the Power Query formula in Excel documents.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "author": "Alex Pedersen",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Vladinator/excel-datamashup/issues"
  },
  "homepage": "https://github.com/Vladinator/excel-datamashup",
  "keywords": [
    "excel",
    "power query"
  ],
  "dependencies": {
    "base64-js": "^1.5.1",
    "binary-parser": "^2.2.1",
    "buffer": "^6.0.3",
    "fflate": "^0.8.2",
    "web-streams-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/base64-js": "^1.3.2",
    "@types/binary-parser": "^1.5.5",
    "typescript": "^5.5.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "arrowParens": "always",
    "endOfLine": "crlf",
    "overrides": [
      {
        "files": [
          "*.json"
        ],
        "options": {
          "tabWidth": 2
        }
      }
    ]
  }
}
